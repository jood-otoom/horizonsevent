# Copy only the VITE_* entries to frontend/.env.local for a connected local test.
# DEMO needs no environment file or network calls.
# A production build requires live mode, the event 17135 Supabase URL, and a publishable key.
# Set these in the Cloudflare Pages production build environment; never put secrets here.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=<LOCAL_OR_APPROVED_PROJECT_URL>
VITE_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY_ONLY>

# Edge Function secrets; configure via Supabase CLI or project settings, never Vite.
# Use separate local and hosted values. Do not place real values in this file.
B2MATCH_API_KEY=<EDGE_FUNCTION_SECRET_ONLY>
B2MATCH_EVENT_ID=17135
B2MATCH_SYNC_ENABLED=false
B2MATCH_DRY_RUN_ENABLED=false
# Include the production Pages origin and retain any approved local origins.
# Multiple exact origins are comma-separated; never use a wildcard.
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5176,https://horizonsevent.pages.dev

# A named Supabase secret API key "automations" is required by sync-b2match.
# It is supplied to Cron through Supabase Vault; no schedule is active in source.
# A separate named secret API key "b2match_verification" is required for
# verify-b2match. It is never placed in browser configuration.
