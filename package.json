{
  "name": "new-horizons-live-dashboard",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @new-horizons/frontend dev",
    "build": "pnpm --filter @new-horizons/frontend build",
    "typecheck": "pnpm --filter @new-horizons/frontend typecheck && pnpm --filter @new-horizons/supabase typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @new-horizons/frontend test && pnpm --filter @new-horizons/supabase test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.48.1"
  }
}
